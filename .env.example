# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_ARC_CHAIN_ID=5042002
NEXT_PUBLIC_ARC_EXPLORER=https://testnet.arcscan.app
NEXT_PUBLIC_CIRCLE_FAUCET_URL=https://faucet.circle.com
NEXT_PUBLIC_ESCROW_REGISTRY_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/circle_court

# Auth / security
AGENT_API_KEY=dev-agent-key
AUDIT_HMAC_SECRET=replace-with-32-byte-secret
RATE_LIMIT_MAX=80
RATE_LIMIT_WINDOW_SECONDS=60

# LLM jury via LiteLLM
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-local
JURY_MODELS=openai/gpt-4.1,anthropic/claude-3-7-sonnet,google/gemini-2.5-pro

# Circle Agent Stack / Wallets / Gateway
CIRCLE_ENV=sandbox
CIRCLE_API_KEY=TEST_API_KEY
CIRCLE_WALLET_SET_ID=00000000-0000-0000-0000-000000000000
CIRCLE_ENTITY_SECRET_CIPHERTEXT=replace-with-circle-entity-secret-ciphertext
CIRCLE_API_BASE=https://api.circle.com/v1/w3s
CIRCLE_CHAIN=ARC-TESTNET
CIRCLE_USDC_TOKEN_ID=USDC
CIRCLE_MOCK=true

# Contracts
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_DEPLOYER_PRIVATE_KEY=
JURY_BRIDGE_ADDRESS=
ESCROW_REGISTRY_ADDRESS=
USDC_ADDRESS=0x0000000000000000000000000000000000000000
